{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bugsy/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@bugsy/ports": [
        "../../packages/ports/src/index.ts"
      ],
      "@bugsy/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@bugsy/repo-memory": [
        "../../adapters/repo.memory/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
